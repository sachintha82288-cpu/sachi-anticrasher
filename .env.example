# Sachi AntiCrasher - environment overrides (optional)
# Copy to .env only if your host loads it, or export these yourself.

# 1 = detect and log but never delete/block (safe first run)
AC_DRY_RUN=0

# Comma separated owner numbers in international format, no +
AC_OWNERS=94771234567

# Command prefix
AC_PREFIX=.

# debug | info | warn | error
AC_LOG_LEVEL=info

# Where the WhatsApp session is stored
AC_AUTH_DIR=auth
